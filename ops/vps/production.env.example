# Production env template for VM deployment. NO SECRETS HERE.
# Copy to /data/arcade/app/.env on the host. Pattern paper needs NO provider keys.
# Frozen scientific settings below MUST NOT change without a benchmark version bump.
REAL_TRADING=0
PAID_MODEL_CALLS=0
PRIMARY_HORIZON_SECONDS=7
PAPER_VERSION=PATTERN_NODES_PAPER_V1
DATA_DIR=/data/arcade/live
# Provider keys intentionally ABSENT (paper arms are deterministic, no inference).
# OPENAI_API_KEY=
# TYPESAFE_API_KEY=
# FASTINO_API_KEY=
