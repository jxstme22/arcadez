# 1. Copy to .env, paste keys on waking. Never commit .env.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
FASTINO_API_KEY=
# Optional public Jupiter source headers (not required for its observed /play host).
JUPITER_API_KEY=
# No wallet, private key, RPC execution key, or trading permissions are used.
DATA_DIR=./var
OPENAI_MODEL=gpt-6-luna
TYPESAFE_MODEL=jev-latest
FASTINO_MODEL=fastino/GLiDE
# Cost guard: total attempted model requests across all accounts per process.
MAX_MODEL_CALLS_PER_SESSION=3000
# Per-provider daily soft request caps (billing limits must ALSO be set in provider dashboards).
MAX_MODEL_CALLS_PER_ARM=1000
REQUEST_TIMEOUT_MS=4500
MAX_PRICE_AGE_MS=2500
PREDICTION_BEFORE_OPEN_MS=10000
PAPER_LOCK_BUFFER_MS=3000
PAPER_STAKE_USDC=10
PAPER_PROB_UP=0.57
PAPER_PROB_DOWN=0.43
# Leave blank until agent verifies actual read-only route and price subscribe schema.
# Verified 2026-10-07: timeline requires ?asset=BTC&before=&after= ; current gives live+bettable.
JUPITER_ROUNDS_URL=https://prediction-market-api.jup.ag/api/v1/play/rounds?asset=BTC&before=5&after=1
JUPITER_ROUNDS_CURRENT_URL=https://prediction-market-api.jup.ag/api/v1/play/rounds/current
# Verified PlayConfig 2026-10-07: betCutoffSeconds=5, feeBps=100. Paper deadline = start - max(BUFFER, CUTOFF+1000).
JUPITER_BET_CUTOFF_MS=5000
JUPITER_PRICE_WS_URL=wss://prediction-market-price-service.fly.dev/ws/crypto
JUPITER_PRICE_WS_SUBSCRIBE_JSON=
JUPITER_OPENAPI_URL=https://prediction-market-api.jup.ag/openapi.json
JUPITER_REST_POLL_MS=2000
DASHBOARD_PORT=8789
